STATUS = ["DISPONÍVEL", "RESERVADO", "INTERDITADO", "LIMPEZA"]

def maximize_window(win):
    try: win.state("zoomed")
    except: pass
    try: win.attributes("-zoomed", True)
    except: pass
    w, h = win.winfo_screenwidth(), win.winfo_screenheight()
    win.geometry(f"{w}x{h}+0+0")

# ==================== Modelo (Quarto com 2 camas) ====================
class Cama:
    def __init__(self, idx, status="DISPONÍVEL", female_only=False, note=""):
        self.idx = idx  # "A" ou "B"
        self.status = status
        self.female_only = bool(female_only)
        self.note = note
        self.reservation = None  # {"nome","matricula","gerencia","obs","obs_blink","check_in","check_out"}

    @property
    def available(self): return self.status == "DISPONÍVEL"
    @property
    def reserved(self): return self.status == "RESERVADO"
    @property
    def interdited(self): return self.status == "INTERDITADO"
    @property
    def cleaning(self): return self.status == "LIMPEZA"

class Quarto:
    def __init__(self, number, female_only=False):
        self.number = str(number)  # 1..32
        self.camas = {
            "A": Cama("A", female_only=female_only),
            "B": Cama("B", female_only=female_only),
        }

def seed_quartos(fem_set=None):
    # Defina aqui os "quartos femininos" (impacta A e B)
    if fem_set is None:
        fem_set = {29, 30, 31, 32}  # 4 quartos femininos por padrão
    quartos = {}
    for no in range(1, 33):  # 32 quartos
        q = Quarto(no, female_only=(no in fem_set))
        quartos[str(no)] = q
    # Estados iniciais (exemplos aplicados à cama A)
    preset = {1: "RESERVADO", 2: "INTERDITADO", 3: "LIMPEZA"}
    for no, st in preset.items():
        if str(no) in quartos:
            quartos[str(no)].camas["A"].status = st
    return quartos

# ==================== Firebase ====================
BASE_URL = "https://hospedagem-18602-default-rtdb.firebaseio.com/hospedagem"

def quartos_to_dict(quartos):
    data = {}
    for qnum, q in quartos.items():
        data[qnum] = {
            "number": q.number,
            "camas": {}
        }
        for cid, c in q.camas.items():
            data[qnum]["camas"][cid] = {
                "idx": c.idx,
                "status": c.status,
                "female_only": c.female_only,
                "note": c.note,
                "reservation": c.reservation
            }
    return data

def dict_to_quartos(data):
    quartos = {}
    if not data:
        return quartos  # Retorna vazio se não houver dados

    if isinstance(data, list):
        for idx, qd in enumerate(data):
            if qd and "number" in qd:
                qnum = str(qd["number"])
                q = Quarto(qnum)
                for cid, cd in qd.get("camas", {}).items():
                    c = q.camas[cid]
                    c.status = cd.get("status", "DISPONÍVEL")
                    c.female_only = cd.get("female_only", False)
                    c.note = cd.get("note", "")
                    c.reservation = cd.get("reservation", None)
                quartos[qnum] = q
    else:
        for qnum, qd in data.items():
            q = Quarto(qnum)
            for cid, cd in qd.get("camas", {}).items():
                c = q.camas[cid]
                c.status = cd.get("status", "DISPONÍVEL")
                c.female_only = cd.get("female_only", False)
                c.note = cd.get("note", "")
                c.reservation = cd.get("reservation", None)
            quartos[str(qnum)] = q
    return quartos




def carregar_quartos_firebase():
    try:
        r = requests.get(f"{BASE_URL}.json", timeout=10, verify=False)
        r.raise_for_status()
        data = r.json()
        return dict_to_quartos(data)
    except Exception as e:
        print("Erro ao carregar quartos do Firebase:", e)
        return seed_quartos()

def salvar_quartos_firebase(quartos):
    try:
        data = quartos_to_dict(quartos)
        r = requests.put(f"{BASE_URL}.json", json=data, timeout=10, verify=False)
        r.raise_for_status()
        print("Salvo com sucesso!")
    except Exception as e:
        print("Erro ao salvar quartos no Firebase:", e)

