                QMessageBox.warning(dlg, "E-mail obrigatório",
                                    "Informe um e-mail válido para enviar a confirmação.")
                ed_email.setFocus()
                return

            if not (nome and ci_date and co_date):
                QMessageBox.warning(dlg, "Campos",
                                    "Preencha Nome, Check-in e Check-out corretamente.")
                return
            if co_date < ci_date:
                QMessageBox.warning(dlg, "Datas",
                                    "Check-out não pode ser anterior ao Check-in.")
                return
            exclude = sel_idx if mode == "edit" else None
            if c.find_overlap(ci_date, co_date, exclude_idx=exclude) is not None:
                QMessageBox.warning(dlg, "Conflito", "Existe sobreposição com outra reserva.")
                return

            # Gera código + horários
            codigo = ''.join(secrets.choice(string.digits) for _ in range(6))
            agora = dt.datetime.now().strftime("%d/%m/%Y %H:%M")

            payload = {
                "nome": nome, "genero": genero,
                "matricula": ed_matricula.text(),
                "gerencia": ed_gerencia.text(),
                "contato": ed_contato.text(),
                "centro_custo": ed_ccusto.text(),
                "ppg_responsavel": ed_ppg_resp.text(),
                "ppg_numero": ed_ppg_num.text(),
                "check_in": ci_date.strftime("%d/%m/%Y"),
                "check_out": co_date.strftime("%d/%m/%Y"),
                "obs": obs,
                "obs_blink": bool(obs),
                "updated_by": self.usuario_ativo or "",
                "updated_at": agora,
                # Confirmação por código
                "status_confirmacao": "PENDENTE",
                "codigo_confirmacao": codigo,
                "codigo_enviado_em": agora,
                "codigo_validado_em": None,
            }

            payload.update({
                "solicitante_reserva": (ed_solicitante.text() or "").strip(),
                "email": email_val,
                "status_confirmacao": "PENDENTE",  # <--- Importante
                "codigo_confirmacao": codigo,
                "codigo_enviado_em": agora,
                "codigo_validado_em": None,
            })

            if mode == "new":
                payload["created_at"] = agora
                payload["operador_reserva"] = self.usuario_ativo or ""
                c.add_reservation(payload)
            else:
                r = c.reservations[sel_idx]
                payload["created_at"] = r.get("created_at", agora)
                payload["operador_reserva"] = r.get("operador_reserva", "")
                c.reservations[sel_idx] = payload

            # --- DEFINE O STATUS INICIAL ---
            # Sempre nasce AGENDADO (Azul), mesmo que seja para hoje, pois precisa do código
            c.status = "AGENDADO"
            c.last_modified_at = agora
            c.last_action = "RESERVA" if mode == "new" else "EDIÇÃO RESERVA"

            self._save_smart(q)
            print("[DEBUG] payload[email] =", payload.get("email"))

            # Enviar código
            try:
                enviar_codigo_confirmacao(
                    email=email_val,
                    nome=payload.get("nome"),
                    codigo=codigo,
                    quarto=q.number,
                    cama=c.idx
                )
            except Exception as e:
                print("Erro ao enviar e-mail de confirmação:", e)
                QMessageBox.warning(self, "E-mail", f"Falha no envio: {e}")

            self.refresh_all()
            dlg.accept()

            try:
                enviar_codigo_confirmacao(
                    email=email_val,  # usa a variável segura
                    nome=payload.get("nome"),
                    codigo=codigo,
                    quarto=q.number,
                    cama=c.idx
                )
            except Exception as e:
                print("Erro ao enviar e-mail de confirmação:", e)
                QMessageBox.warning(self, "E-mail", f"Falha no envio: {e}")

        btn_save.clicked.connect(do_save)
        btn_cancel.clicked.connect(dlg.reject)
        dlg.exec()

