import smtplib
from email.mime.text import MIMEText
from email.mime.multipart import MIMEMultipart


def enviar_codigo_confirmacao(email, nome, codigo, quarto, cama):
    """
    Envia o código de confirmação.
    Prioridade 1: Outlook Local (não requer senha no .env).
    Prioridade 2: SMTP (fallback caso o Outlook falhe ou não exista).
    """
    import os
    import smtplib
    from email.mime.text import MIMEText
    from email.mime.multipart import MIMEMultipart

    # 1. Monta o conteúdo do E-mail (HTML)
    assunto = "Código de confirmação da reserva"

    html = f"""
    <div style="font-family:Segoe UI, Arial;">
        <h2>Confirmação de Reserva</h2>
        <p>Olá <strong>{nome}</strong>,</p>

        <p>Seu código de confirmação é:</p>

        <div style="
            font-size:24px;
            font-weight:800;
            letter-spacing:4px;
            background:#F3F4F6;
            display:inline-block;
            padding:12px 20px;
            border-radius:8px;
        ">
            {codigo}
        </div>

        <p>
            Reserva: <br>
            <strong>Quarto {quarto} — Cama {cama}</strong>
        </p>

        <p style="color:#6B7280;">
            Esse código é necessário para confirmar sua reserva.
        </p>
    </div>
    """

    # 2. TENTATIVA VIA OUTLOOK (Prioridade - Sem senha)
    if OUTLOOK_AVAILABLE:
        print(f"[Email] Tentando enviar código para {email} via Outlook Local...")
        try:
            sucesso = enviar_email_outlook(email, assunto, html)
            if sucesso:
                print("[Email] ✅ Sucesso via Outlook!")
                return  # <--- Sai aqui se funcionar, ignorando SMTP
        except Exception as e:
            print(f"[Email] ⚠️ Falha ao tentar Outlook: {e}. Tentando fallback SMTP...")
    else:
        print("[Email] Outlook local não disponível. Indo para SMTP...")

    # 3. TENTATIVA VIA SMTP (Fallback - Requer .env)
    smtp_host = os.getenv("SMTP_HOST") or "smtp.office365.com"
    smtp_user = os.getenv("SMTP_USER")
    smtp_pass = os.getenv("SMTP_PASS")

    # Tratamento da porta
    try:
        smtp_port = int(os.getenv("SMTP_PORT") or 587)
    except:
        smtp_port = 587

    # Se não tiver credenciais, apenas avisa e desiste (não trava o app)
    if not smtp_user or not smtp_pass:
        print("[Email] ❌ Erro: Outlook falhou/inexistente e credenciais SMTP não configuradas no .env.")
        return

    msg = MIMEMultipart("alternative")
    msg["Subject"] = assunto
    msg["From"] = smtp_user
    msg["To"] = email
    msg.attach(MIMEText(html, "html"))

    try:
        with smtplib.SMTP(smtp_host, smtp_port) as server:
            server.starttls()
            server.login(smtp_user, smtp_pass)
            server.send_message(msg)
        print("[Email] ✅ Sucesso via SMTP!")
    except Exception as e:
        print(f"[Email] ❌ Erro fatal no envio SMTP: {e}")
        # Opcional: Levantar um alerta visual no Qt aqui se desejar


