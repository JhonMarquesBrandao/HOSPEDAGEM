        # Timer realtime (5s)
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh)
        self.timer.start(5_000)
        self.refresh()

    def _apply_row_style(self, row: int, status_text: str, privilegio_text: str):
        status = (status_text or "").strip().lower()
        priv = (privilegio_text or "").strip().lower()
        color = None
        if status == "online":
            color = QColor(209, 250, 229)  # verde claro
        elif status == "offline":
            color = QColor(243, 244, 246)  # cinza claro
        if priv == "pendente":
            color = QColor(254, 249, 195)  # amarelo claro
        if color:
            for col in range(self.tbl.columnCount()):
                item = self.tbl.item(row, col)
                if item:
                    item.setBackground(color)

    def refresh(self):
        usuarios = ler_usuarios_firebase() or {}
        filter_val = (self.cb_filter.currentText() or "Todos").lower()
        pendentes = [];
        online = [];
        offline = []
        for u, info in usuarios.items():
            st = (info.get("status", "offline") or "offline").lower()
            priv = (info.get("privilegio", "usuario") or "usuario").lower()
            if priv == "pendente":
                pendentes.append(u)
            if st == "online":
                online.append(u)
            else:
                offline.append(u)
        self.lbl_pend.setText(f"Pendentes: {len(pendentes)}")
        self.lbl_on.setText(f"Online: {len(online)}")
        self.lbl_off.setText(f"Offline: {len(offline)}")
        self.lbl_online_list.setText("🟢 Online agora: " + (", ".join(sorted(online)) if online else "—"))
        self.lbl_offline_list.setText("⚪ Offline agora: " + (", ".join(sorted(offline)) if offline else "—"))
        self.tbl.setRowCount(0)
        for u, info in usuarios.items():
            stat = (info.get("status", "offline") or "offline").lower()
            priv = (info.get("privilegio", "usuario") or "usuario").lower()
            if filter_val == "online" and stat != "online":
                continue
            if filter_val == "offline" and stat != "offline":
                continue
            if filter_val == "pendente" and priv != "pendente":
                continue
            row = self.tbl.rowCount()
            self.tbl.insertRow(row)
            self.tbl.setItem(row, 0, QTableWidgetItem(u))
            self.tbl.setItem(row, 1, QTableWidgetItem(info.get("nome_completo", "") or ""))
            self.tbl.setItem(row, 2, QTableWidgetItem(info.get("email", "") or ""))
            cb_priv = QComboBox();
            cb_priv.addItems(["usuario", "admin", "pendente"]);
            cb_priv.setCurrentText(priv)
            self.tbl.setCellWidget(row, 3, cb_priv)
            it_status = QTableWidgetItem(info.get("status", "offline") or "offline")
            it_status.setForeground(QColor(22, 101, 52) if stat == "online" else QColor(71, 85, 105))
            it_status.setTextAlignment(Qt.AlignCenter)
            self.tbl.setItem(row, 4, it_status)
            self.tbl.setItem(row, 5, QTableWidgetItem(info.get("gerencia", "") or ""))
            self.tbl.setItem(row, 6, QTableWidgetItem(info.get("empresa", "") or ""))
            # Ações: Nova senha + botões
            w_actions = QWidget()
            h = QHBoxLayout(w_actions);
            h.setContentsMargins(4, 4, 4, 4);
            h.setSpacing(8)
            ed_senha = QLineEdit()
            ed_senha.setPlaceholderText("Nova senha")
            ed_senha.setEchoMode(QLineEdit.Password)
            ed_senha.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
            ed_senha.setMinimumWidth(160)
            ed_senha.setMinimumHeight(40)  # altura maior
            ed_senha.setStyleSheet("padding:10px 12px; border-radius:10px; font-size:14px;")
            btn_eye = QToolButton()
            btn_eye.setIcon(self.style().standardIcon(QStyle.SP_FileDialogDetailedView))
            btn_eye.setToolTip("Mostrar/ocultar senha")

            def toggle_eye():
                ed_senha.setEchoMode(
                    QLineEdit.Normal if ed_senha.echoMode() == QLineEdit.Password else QLineEdit.Password)

            btn_eye.clicked.connect(toggle_eye)
            btn_save = QToolButton()
            btn_save.setText("Salvar")
            btn_save.setIcon(self.style().standardIcon(QStyle.SP_DialogSaveButton))
            btn_save.setToolButtonStyle(Qt.ToolButtonTextBesideIcon)
            btn_save.setAutoRaise(True)
            btn_save.setCursor(Qt.PointingHandCursor)
            btn_save.setToolTip("Salvar alterações do usuário")
            btn_del = QToolButton()
            btn_del.setText("Excluir")
            btn_del.setIcon(self.style().standardIcon(QStyle.SP_TrashIcon))
            btn_del.setToolButtonStyle(Qt.ToolButtonTextBesideIcon)
            btn_del.setAutoRaise(True)
            btn_del.setCursor(Qt.PointingHandCursor)
            btn_del.setToolTip("Excluir usuário")
            h.addWidget(ed_senha)
            h.addWidget(btn_eye)
            h.addWidget(btn_save)
            h.addWidget(btn_del)
            h.addStretch(1)
            h.setStretchFactor(ed_senha, 1)
            self.tbl.setCellWidget(row, 7, w_actions)

            def make_handlers(user=u, ed=ed_senha, cb=cb_priv):
                def do_save():
                    new_pass = ed.text().strip() or None
                    new_priv = cb.currentText()
                    if new_pass is not None and len(new_pass) < 8:
                        QMessageBox.warning(self, "Senha", "A nova senha deve ter pelo menos 8 caracteres.")
                        return
                    ok = editar_usuario_firebase(user, nova_senha=new_pass, novo_privilegio=new_priv)
                    QMessageBox.information(self, "Usuário",
                                            "Usuário editado com sucesso!" if ok else "Erro ao editar usuário!")
                    self.refresh()

                def do_del():
                    ok = excluir_usuario_firebase(user)
                    QMessageBox.information(self, "Usuário", "Usuário excluído!" if ok else "Erro ao excluir usuário!")
                    self.refresh()

                return do_save, do_del

            save_fn, del_fn = make_handlers()
            btn_save.clicked.connect(save_fn)
            btn_del.clicked.connect(del_fn)
            self._apply_row_style(row, it_status.text(), cb_priv.currentText())

    def force_refresh_data(self):
        """Força o download dos dados do Firebase e atualiza todas as telas."""
        try:
            # Muda o texto do cursor/botão para dar feedback
            QApplication.setOverrideCursor(Qt.WaitCursor)

            # 1. Baixa tudo do Firebase novamente
            self.quartos = carregar_quartos_firebase()
            self.historico = carregar_historico_firebase()
            self.ranking = carregar_ranking()

            # 2. Atualiza a tela
            self.refresh_all()

            QApplication.restoreOverrideCursor()
            QMessageBox.information(self, "Sincronização", "✅ Dados atualizados com o servidor!")
        except Exception as e:
            QApplication.restoreOverrideCursor()
            print(f"Erro ao atualizar: {e}")
            QMessageBox.warning(self, "Erro", "Falha ao baixar dados do servidor.")


# ==== UI: Configurações (Admin) ====
class ConfigAdminWidget(QWidget):
    """
    Aba de Configurações PROFISSIONAL:
    - Alertas: limiar, modo, cooldown, som, banner
    - KPIs: política de bloqueio de quarto e exclusão de vagas livres em bloqueados
    - Mapa: dias exibidos e limite de nomes por célula
    - Ações: Liberar TODOS, Bloquear TODOS, Recalcular status, Parar piscar OBS
    """

    def __init__(self, parent_app: HospedagemProQt):
        super().__init__(parent_app)
        self.app = parent_app
        v = QVBoxLayout(self);
        v.setContentsMargins(8, 8, 8, 8);
        v.setSpacing(12)
        title = QLabel("⚙️ Configurações do Sistema")
        title.setStyleSheet("font-weight:800; font-size:16px;")
        v.addWidget(title)
        cfg = self.app.config
        # Grupo Alertas
        grp_alert = QGroupBox("🔔 Alertas")
        f_alert = QFormLayout(grp_alert);
        f_alert.setContentsMargins(12, 12, 12, 12);
        f_alert.setSpacing(8)
        self.sp_threshold = QSpinBox();
        self.sp_threshold.setRange(50, 100);
        self.sp_threshold.setSuffix(" %");
        self.sp_threshold.setValue(int(cfg.get("alert_threshold_percent", 80)))
        self.cb_mode = QComboBox();
        self.cb_mode.addItems(["rooms_union", "rooms_occupied", "rooms_blocked", "beds"]);
        self.cb_mode.setCurrentText(cfg.get("alert_mode", "rooms_union"))
        self.sp_cooldown = QSpinBox();
        self.sp_cooldown.setRange(60, 3600);
        self.sp_cooldown.setSuffix(" s");
        self.sp_cooldown.setValue(int(cfg.get("alert_cooldown_sec", 600)))
        self.cb_sound = QCheckBox("Tocar beep ao disparar alerta");
        self.cb_sound.setChecked(bool(cfg.get("alert_sound", True)))
        self.cb_banner = QCheckBox("Mostrar banner detalhado");
        self.cb_banner.setChecked(bool(cfg.get("alert_banner", True)))
        f_alert.addRow("Percentual do alerta", self.sp_threshold)
        f_alert.addRow("Modo do alerta", self.cb_mode)
        f_alert.addRow("Cooldown entre alertas", self.sp_cooldown)
        f_alert.addRow(self.cb_sound)
        f_alert.addRow(self.cb_banner)
        v.addWidget(grp_alert)
        # Grupo KPIs
        grp_kpi = QGroupBox("📊 KPIs")
        f_kpi = QFormLayout(grp_kpi);
        f_kpi.setContentsMargins(12, 12, 12, 12);
        f_kpi.setSpacing(8)
        self.cb_block_policy = QComboBox();
        self.cb_block_policy.addItems(["any_bed", "both_beds"]);
        self.cb_block_policy.setCurrentText(cfg.get("blocked_room_policy", "any_bed"))
        self.cb_free_excl = QCheckBox("Não contar vagas livres em quartos bloqueados");
        self.cb_free_excl.setChecked(bool(cfg.get("kpi_count_free_excludes_blocked", False)))
        f_kpi.addRow("Política de quarto bloqueado", self.cb_block_policy)
        f_kpi.addRow(self.cb_free_excl)
        v.addWidget(grp_kpi)
        # Grupo Mapa
        grp_map = QGroupBox("🗺️ Mapa de Reservas")
        f_map = QFormLayout(grp_map);
        f_map.setContentsMargins(12, 12, 12, 12);
        f_map.setSpacing(8)
        self.sp_map_days = QSpinBox();
        self.sp_map_days.setRange(3, 30);
        self.sp_map_days.setValue(int(cfg.get("map_days", 7)))
        self.sp_names_limit = QSpinBox();
        self.sp_names_limit.setRange(1, 5);
        self.sp_names_limit.setValue(int(cfg.get("show_map_names_limit", 2)))
        self.sp_auto = QSpinBox();
        self.sp_auto.setRange(5000, 120000);
        self.sp_auto.setSuffix(" ms");
        self.sp_auto.setValue(int(cfg.get("auto_refresh_ms", 30000)))
        f_map.addRow("Dias exibidos no mapa", self.sp_map_days)
        f_map.addRow("Nomes por célula", self.sp_names_limit)
        f_map.addRow("Atualização automática", self.sp_auto)
        v.addWidget(grp_map)
        # Botão salvar
        h = QHBoxLayout();
        h.addStretch(1)
        btn_save = QPushButton("Salvar Configurações");
        h.addWidget(btn_save)
        v.addLayout(h)

        def do_save():
            cfg_new = {
                "alert_threshold_percent": int(self.sp_threshold.value()),
                "alert_mode": self.cb_mode.currentText(),
                "alert_cooldown_sec": int(self.sp_cooldown.value()),
                "auto_refresh_ms": int(self.sp_auto.value()),
                "alert_sound": bool(self.cb_sound.isChecked()),
                "alert_banner": bool(self.cb_banner.isChecked()),
                "blocked_room_policy": self.cb_block_policy.currentText(),
                "kpi_count_free_excludes_blocked": bool(self.cb_free_excl.isChecked()),
                "map_days": int(self.sp_map_days.value()),
                "show_map_names_limit": int(self.sp_names_limit.value()),
            }
            ok = salvar_config(cfg_new)
            if ok:
                self.app.config = cfg_new
                try:
                    self.app.auto_timer.stop()
                    self.app.auto_timer.start(int(cfg_new.get("auto_refresh_ms", 30000)))
                except:
                    pass
                QMessageBox.information(self, "Configurações", "✅ Configurações salvas e aplicadas.")
                self.app.update_kpis()
                self.app.refresh_mapa_from_model()
            else:
                QMessageBox.warning(self, "Configurações", "❌ Erro ao salvar configurações.")

        btn_save.clicked.connect(do_save)
        # Grupo Ações em massa
        grp_actions = QGroupBox("🛠️ Ações em Massa")
        actions_row = QHBoxLayout(grp_actions);
        actions_row.setSpacing(10)
        btn_release_all = QPushButton("Liberar TODOS os quartos")
        btn_block_all = QPushButton("Bloquear TODOS os quartos")
        btn_recalc = QPushButton("Recalcular status por data")
        btn_stop_obs = QPushButton("Parar piscar TODAS as OBS")
        btn_release_all.setStyleSheet(
            "background:#10B981; color:white; font-weight:700; padding:8px 12px; border-radius:10px;")
        btn_block_all.setStyleSheet(
            "background:#DC2626; color:white; font-weight:700; padding:8px 12px; border-radius:10px;")
        btn_recalc.setStyleSheet(
            "background:#2563EB; color:white; font-weight:700; padding:8px 12px; border-radius:10px;")
        btn_stop_obs.setStyleSheet(
            "background:#6B7280; color:white; font-weight:700; padding:8px 12px; border-radius:10px;")
        actions_row.addWidget(btn_release_all)
        actions_row.addWidget(btn_block_all)
        actions_row.addWidget(btn_recalc)
        actions_row.addWidget(btn_stop_obs)
        v.addWidget(grp_actions)

        def do_release_all():
            ret = QMessageBox.question(self, "Liberar todos",
                                       "Tem certeza que deseja liberar TODOS os quartos?\n(Reservas permanecem; status será ajustado por regra.)",
                                       QMessageBox.Yes | QMessageBox.No, QMessageBox.No)
            if ret != QMessageBox.Yes:
                return
            now_str = dt.datetime.now().strftime("%d/%m/%Y %H:%M")
            today = dt.date.today()
            total = 0
            for q in self.app.quartos.values():
                for c in q.camas.values():
                    c.interditado_motivo = ""
                    c.operador_liberacao = self.app.usuario_ativo or ""
                    _, ar = c.get_active_reservation(today)
                    if ar:
                        c.status = "OCUPADO"
                    else:
                        _, nxt = c.get_next_reservation(today)
                        c.status = "AGENDADO" if nxt else "DISPONÍVEL"
                    c.last_modified_at = now_str
                    total += 1
            salvar_quartos_firebase(self.app.quartos)
            self.app.refresh_all()
            QMessageBox.information(self, "Liberar todos", f"✅ {total} camas/slots ajustados e liberados.")

        def do_block_all():
            motivo, ok = QInputDialog.getText(self, "Bloquear todos",
                                              "Informe o motivo do bloqueio (aplicado em todos):")
            if not ok:
                return
            motivo = (motivo or "").strip()
            if not motivo:
                QMessageBox.warning(self, "Bloquear todos", "Informe um motivo.")
                return
            ret = QMessageBox.question(self, "Bloquear todos",
                                       "Tem certeza que deseja BLOQUEAR TODOS os quartos?\n(Reservas permanecem, mas o status fica INTERDITADO.)",
                                       QMessageBox.Yes | QMessageBox.No, QMessageBox.No)
            if ret != QMessageBox.Yes:
                return
            now_str = dt.datetime.now().strftime("%d/%m/%Y %H:%M")
            total = 0
            for q in self.app.quartos.values():
                for c in q.camas.values():
                    c.status = "INTERDITADO"
                    c.interditado_motivo = motivo
                    c.operador_bloqueio = self.app.usuario_ativo or ""
                    c.last_modified_at = now_str
                    total += 1
            salvar_quartos_firebase(self.app.quartos)
            self.app.refresh_all()
            QMessageBox.information(self, "Bloquear todos", f"⛔ {total} camas/slots bloqueados com motivo: {motivo}")

        def do_recalc():
            self.app.sync_status_by_date()
            salvar_quartos_firebase(self.app.quartos)
            self.app.refresh_all()
            QMessageBox.information(self, "Recalcular", "✅ Status recalculado conforme datas de reserva.")

        def do_stop_obs():
            total = 0
            for q in self.app.quartos.values():
                for c in q.camas.values():
                    for r in c.reservations:
                        if r.get("obs_blink", False):
                            r["obs_blink"] = False
                            total += 1
            salvar_quartos_firebase(self.app.quartos)
            self.app.refresh_all()
            QMessageBox.information(self, "Observações", f"✅ Parada de piscar aplicada em {total} observação(ões).")

        btn_release_all.clicked.connect(do_release_all)
        btn_block_all.clicked.connect(do_block_all)
        btn_recalc.clicked.connect(do_recalc)
        btn_stop_obs.clicked.connect(do_stop_obs)


