        )
        bloqueados_quartos = sum(1 for q in quartos if self._is_room_blocked(q))
        livres_quartos = len(quartos) - sum([
            1 if (any(getattr(c, 'status', '') == 'OCUPADO' for c in q.camas.values())
                  or any(c.get_next_reservation(hoje)[1] is not None for c in q.camas.values())
                  or self._is_room_blocked(q)) else 0
