    # === Filtros ===
    def apply_filter(self):
        q = (self.search_entry.text() or "").strip().lower()
        self.filtered = None if not q else set()
        for qkey, quarto in self.quartos.items():
            match = False
            for c in quarto.camas.values():
                reservas_text = []
                for r in c.reservations:
                    reservas_text.extend([
                        r.get("nome", ""), r.get("matricula", ""), r.get("gerencia", ""),
                        r.get("genero", ""), r.get("obs", ""), r.get("check_in", ""), r.get("check_out", ""),
                        r.get("operador_reserva", ""), r.get("updated_by", ""),
                        r.get("contato", ""), r.get("centro_custo", ""),
                    ])
                hay = " ".join([quarto.number, c.idx, c.status, c.note or "", c.contato or ""] + reservas_text).lower()
                if not q or q in hay:
                    match = True;
                    break
            if match and self.filtered is not None:
                self.filtered.add(qkey)
        self.render_room_cards()
        self.update_kpis()
        self.refresh_desempenho()

    def clear_filter(self):
        self.search_entry.setText("")
        self.filtered = None
        self.render_room_cards()
        self.update_kpis()
        self.refresh_desempenho()

