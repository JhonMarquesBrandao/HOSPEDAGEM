    def _trigger_alert_if_needed(self, indisponiveis_quartos, total_quartos, ocupados, bloqueados):
        if total_quartos <= 0:
            self.badge_alert.hide()
            self.alert_banner.setVisible(True)
            self.banner_timer.stop()
            return

        threshold = float(self.config.get("alert_threshold_percent", 80)) / 100.0
        perc = indisponiveis_quartos / total_quartos
        livres = total_quartos - indisponiveis_quartos

        if perc >= threshold:
            # --- UI: mantém alerta visível ---
            self.badge_alert.setText(f"⚠ Indisponíveis {perc * 100:.0f}%")
            self.badge_alert.show()

            if self.config.get("alert_banner", True):
                self._last_alert_stats = {
                    "total_quartos": total_quartos,
                    "indisponiveis": indisponiveis_quartos,
                    "ocupados": ocupados,
                    "bloqueados": bloqueados,
                    "livres": livres,
                    "percent": f"{perc * 100:.1f}"
                }
                txt = (f"⛔ QUARTOS INDISPONÍVEIS: {indisponiveis_quartos}/{total_quartos} "
                       f"({perc * 100:.1f}%) • Ocupados: {ocupados} • Bloqueados: {bloqueados} • Livres: {livres}")
                self.alert_text.setText(txt)
                self.alert_banner.setVisible(True)
                if not self.banner_timer.isActive():
                    self.banner_timer.start(900)

            # --- Som / diálogo com cooldown (como já estava) ---
            now = dt.datetime.now()
            cooldown = int(self.config.get("alert_cooldown_sec", 600))
            should_notify_popup = (self._last_occupancy_alert is None) or (
                    (now - self._last_occupancy_alert).total_seconds() > cooldown
            )
            if should_notify_popup:
                if self.config.get("alert_sound", True):
                    try:
                        QApplication.beep()
                    except:
                        pass
                QMessageBox.warning(
                    self, "Alerta de Ocupação",
                    (f"A porcentagem de QUARTOS indisponíveis (ocupados ou bloqueados) atingiu {perc * 100:.1f}% "
                     f"(Percentual: {threshold * 100:.0f}%).\n\n"
                     f"• Total de quartos: {total_quartos}\n"
                     f"• Indisponíveis: {indisponiveis_quartos}\n"
                     f"• Ocupados: {ocupados}\n"
                     f"• Bloqueados: {bloqueados}\n"
                     f"• Livres: {livres}")
                )
                self._last_occupancy_alert = now

            # --- NOVO: e-mail apenas uma vez por evento (edge-trigger) ---
            try:

                if bloqueados > 0 and not self._alert_email_sent:
                    # Recalcula KPIs e cancelamentos no momento do alerta
                    kpi = self._kpis_para_email()
                    canc = self._cancellations_para_email()
                    html = self._build_html_admin_email(kpi, canc)

                    assunto = (
                        f"Alerta/Relatório — {kpi['perc_indisponiveis_quartos']}% indisponíveis "
                        f"(Quartos: {kpi['indisponiveis_quartos']}/{kpi['total_quartos']})"
                    )

                    # Envia para todos admins cadastrados com o HTML completo
                    notificar_admins(assunto, html)

                    # Marca como enviado para este ciclo de alerta
                    self._alert_email_sent = True
            except Exception as e:
                print('[AdminEmail] erro ao notificar alerta:', e)

        else:
            # --- “Descida”: abaixo do limiar -> oculta UI e permite novo e-mail na próxima subida ---
            self.badge_alert.hide()
            self.alert_banner.setVisible(False)
            self.banner_timer.stop()
            # NOVO: resetar o edge-trigger para permitir novo envio na próxima subida
            self._alert_email_sent = False

