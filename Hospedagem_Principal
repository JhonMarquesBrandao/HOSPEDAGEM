# ==== Relatórios (cálculos secundários) ====
class Relatorios:
    def __init__(self, quartos, historico=None):
        self.quartos = quartos
        self.historico = historico or []

    def relatorio_quartos_ocupados_diario(self):
        ocupados = sum(1 for q in self.quartos.values() if any(c.reserved for c in q.camas.values()))
        total = len(self.quartos)
        return f"Quartos ocupados: {ocupados}/{total}"

    def relatorio_leitos_diario(self):
        camas = [c for q in self.quartos.values() for c in q.camas.values()]
        ocupados = sum(1 for c in camas if c.reserved)
        desocupados = len(camas) - ocupados
        return f"Leitos ocupados: {ocupados}/{len(camas)} \n Desocupados: {desocupados}"

    def mapa_reservas_proximos_5_dias(self):
        hoje = dt.date.today()
        proximos_5 = [hoje + dt.timedelta(days=i) for i in range(5)]
        mapa = {d.strftime("%d/%m"): [] for d in proximos_5}
        for q in self.quartos.values():
            for c in q.camas.values():
                for r in c.reservations:
                    try:
                        ci = dt.datetime.strptime(r.get("check_in"), "%d/%m/%Y").date()
                        co = dt.datetime.strptime(r.get("check_out", ""), "%d/%m/%Y").date()
                        for d in proximos_5:
                            if ci <= d <= co:
                                mapa[d.strftime("%d/%m")].append(f"Quarto {q.number} • Cama {c.idx}")
                    except:
                        pass
        return mapa


