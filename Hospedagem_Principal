    return _fb_url(base)


def ler_usuarios_firebase():
    try:
        url = _usuarios_url()
        resp = requests.get(url, timeout=10, verify=REQUESTS_VERIFY)
        resp.raise_for_status()
        dados = resp.json()
        return dados if dados else {}
    except Exception as e:
        print(f"Erro ao ler usuarios: {e}")
        return {}


def salvar_usuario_firebase(usuario, senha, privilegio, email, nome_completo, identificacao, gerencia, empresa):
    try:
        dados = {
            "usuario": usuario,
            "senha": senha,
            "privilegio": privilegio,
            "email": email,
            "nome_completo": nome_completo,
            "identificacao": identificacao,
            "gerencia": gerencia,
            "empresa": empresa,
            "status": "offline",
            "criado_em": dt.datetime.now().strftime("%d/%m/%Y %H:%M:%S"),
        }
        url = _usuarios_url(usuario)
        resp = requests.put(url, json=dados, timeout=10, verify=REQUESTS_VERIFY)
        resp.raise_for_status()
        return True
    except Exception as e:
        print(f"Erro ao salvar usuario: {e}")
        return False


def editar_usuario_firebase(usuario, nova_senha=None, novo_privilegio=None):
    try:
        payload = {}
        if nova_senha is not None:
            payload["senha"] = nova_senha
        if novo_privilegio is not None:
            payload["privilegio"] = novo_privilegio
        if not payload:
            return True
        url = _usuarios_url(usuario)
        resp = requests.patch(url, json=payload, timeout=10, verify=REQUESTS_VERIFY)
        resp.raise_for_status()
        return True
    except Exception as e:
        print(f"Erro ao editar usuario: {e}")
        return False


def excluir_usuario_firebase(usuario):
    try:
        url = _usuarios_url(usuario)
        resp = requests.delete(url, timeout=10, verify=REQUESTS_VERIFY)
        resp.raise_for_status()
        return True
    except Exception as e:
        print(f"Erro ao excluir usuario: {e}")
        return False


