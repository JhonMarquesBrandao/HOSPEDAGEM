        def cancel_reservation_with_logging(self, q, c, sel_idx, dlg):
            from PySide6.QtWidgets import QMessageBox, QInputDialog
            import datetime as dt

            if sel_idx is None or sel_idx < 0 or sel_idx >= len(c.reservations or []):
                QMessageBox.warning(dlg, "Cancelar", "Seleção inválida.")
                return

            res = c.reservations[sel_idx]

            ret = QMessageBox.question(
                dlg, "Confirmar Cancelamento",
                f"Deseja realmente excluir a reserva de {res.get('nome', '—')}?\nEsta ação não pode ser desfeita.",
                QMessageBox.Yes | QMessageBox.No, QMessageBox.No
            )
            if ret != QMessageBox.Yes:
                return
            from PySide6.QtWidgets import QInputDialog, QMessageBox

            from PySide6.QtWidgets import QInputDialog, QMessageBox

            while True:
                motivo, ok_m = QInputDialog.getText(
                    dlg,
                    "Motivo do Cancelamento (obrigatório)",
                    "Informe o motivo do cancelamento:"
                )

                if not ok_m:
                    # Usuário cancelou → aborta tudo
                    QMessageBox.information(
                        dlg,
                        "Cancelamento abortado",
                        "O cancelamento foi interrompido porque o motivo não foi informado."
                    )
                    return

                motivo = (motivo or "").strip()

                if motivo:
                    break  # ✅ motivo válido, sai do loop

                QMessageBox.warning(
                    dlg,
                    "Campo obrigatório",
                    "⚠️ O motivo do cancelamento é obrigatório.\n\n"
                    "Informe um motivo para prosseguir."
                )

            agora_str = dt.datetime.now().strftime("%d/%m/%Y %H:%M")
            operador = getattr(self, 'usuario_ativo', '') or ''

            hist_entry_cancel = {
                "tipo": "CANCELAMENTO",
                "nome": res.get("nome", ""),
                "gerencia": res.get("gerencia", ""),
                "matricula": res.get("matricula", ""),
                "quarto": q.number,
                "cama": c.idx,
                "check_in": res.get("check_in", ""),
                "check_out": res.get("check_out", ""),
                "cancelado_em": agora_str,
                "operador_cancelamento": operador,
                "cancel_reason": motivo,
                "obs": (res.get("obs") or ""),
                "last_action_by": operador,
                "last_action_at": agora_str,
            }
            try:
                append_historico(hist_entry_cancel)
                if hasattr(self, 'historico') and isinstance(self.historico, list):
                    self.historico.append(hist_entry_cancel)
            except Exception as e:
                print('[Cancelamento] Warn: não foi possível registrar histórico:', e)

            try:
                c.remove_reservation(sel_idx)
            except Exception as e:
                print('[Cancelamento] Erro ao remover reserva:', e)

            hoje = dt.date.today()
            try:
                ai, ar = c.get_active_reservation(hoje)
            except Exception:
                ai, ar = None, None
            if ar:
                c.status = 'OCUPADO'
            else:
                try:
                    _, nxt = c.get_next_reservation(hoje)
                except Exception:
                    nxt = None
                c.status = 'AGENDADO' if nxt else 'DISPONÍVEL'

            c.last_modified_at = agora_str
            c.last_action_by = operador
            c.last_action = 'CANCELAMENTO'
            c.last_action_at = agora_str

            try:
                salvar_quartos_firebase(self.quartos)
            except Exception as e:
                print('[Cancelamento] Erro ao salvar quartos no Firebase:', e)

            try:
                if hasattr(self, 'refresh_all'):
                    self.refresh_all()
                QMessageBox.information(dlg, 'Sucesso', 'Agendamento cancelado com sucesso.')
                dlg.accept()
            except Exception:
                pass

        def parse_date(s):
            s = (s or "").strip()
            if not s: return None
            try:
                return dt.datetime.strptime(s, "%d/%m/%Y").date()
            except:
                return None

        def do_save():
            nome = (ed_nome.text() or "").strip()
            genero = (cb_genero.currentText() or "").strip()
            ci_date = parse_date(ed_check_in.text())
            co_date = parse_date(ed_check_out.text())
            obs = (ed_obs.text() or "").strip()

            email_val = (ed_email.text() or "").strip()
