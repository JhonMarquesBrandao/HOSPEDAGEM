    def _downloads_dir(self) -> str:
        """Retorna o caminho da pasta Downloads do usuário, com fallback para ~/Downloads."""
        try:
            from PySide6.QtCore import QStandardPaths
            base = QStandardPaths.writableLocation(QStandardPaths.DownloadLocation)
            if base and os.path.isdir(base):
                return base
        except Exception:
            pass
        # Fallback multiplataforma
        home = os.path.expanduser("~")
        for cand in [
            os.path.join(home, "Downloads"),  # Linux/macOS
            os.path.join(home, "Documentos"),  # fallback PT
            home
        ]:
            if os.path.isdir(cand):
                return cand
        return os.getcwd()

    def _sanitize_sheet_title(self, title: str, used: set[str] | None = None) -> str:
        """
        Garante título válido para aba Excel:
         - remove caracteres inválidos: : \ / ? * [ ]
         - limita a 31 chars
         - assegura unicidade (sufixo " (2)", " (3)", ...)
        """
        invalid = set(':\\/?*[]')
        cleaned = ''.join(ch for ch in (title or '').strip() if ch not in invalid)
        cleaned = cleaned or "Sheet"
        if len(cleaned) > 31:
            cleaned = cleaned[:31]

        # unicidade
        if used is None:
            return cleaned
        base = cleaned
        i = 2
        while cleaned in used:
            suffix = f" ({i})"
            maxlen = 31 - len(suffix)
            cleaned = (base[:maxlen] + suffix) if maxlen > 0 else f"S{i}"
            i += 1
        used.add(cleaned)
        return cleaned

    def _add_sheet(self, wb, title: str, used: set[str]):
        """Cria Sheet com título sanitizado e devolve worksheet."""
        valid_title = self._sanitize_sheet_title(title, used)
        try:
            ws = wb.create_sheet(valid_title)
        except Exception:
            # fallback caso create_sheet falhe por algum motivo
            ws = wb.create_sheet()
            ws.title = self._sanitize_sheet_title("Planilha", used)
        return ws

