@firebase_retry(fallback=lambda: None)
def incrementa_ranking(nome: str, gerencia: str):
    nome = (nome or "").strip()
    gerencia = (gerencia or "").strip()
    if not nome or not gerencia:
        return None
    current = carregar_ranking()
    branch = current.get(gerencia, {})
    branch[nome] = int(branch.get(nome, 0)) + 1
    current[gerencia] = branch
    salvar_ranking(current)
    return branch[nome]


def top10_from_ranking(ranking_dict):
    pairs = []
    for ger, names in (ranking_dict or {}).items():
        if isinstance(names, dict):
            for nome, cnt in names.items():
                try:
                    c = int(cnt)
                except:
                    c = 0
                pairs.append((nome, ger, c))
    pairs.sort(key=lambda tup: tup[2], reverse=True)
    return pairs[:10]


