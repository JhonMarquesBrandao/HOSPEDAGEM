class HospedagemProQt(QMainWindow):
    AUTO_RELEASE_AFTER_CHECKOUT = False

    def _kpis_para_email(self):
        """Calcula KPIs com base em self.quartos e self.config."""

        def _is_room_blocked(q):
            policy = (self.config.get("blocked_room_policy", "any_bed") or "any_bed").strip().lower()
            beds = list(q.camas.values())
            if policy == "both_beds":
                return all(getattr(c, "status", "") == "INTERDITADO" for c in beds)
            return any(getattr(c, "status", "") == "INTERDITADO" for c in beds)

        quartos = list(self.quartos.values())
        camas = [c for q in quartos for c in q.camas.values()]
        total_vagas = len(camas)
        vagas_ocupadas = sum(1 for c in camas if c.status == "OCUPADO")
        total_quartos = len(quartos)
        quartos_ocupados = sum(1 for q in quartos if any(c.status == "RESERVADO" for c in q.camas.values()))
        quartos_Agendados = sum(1 for q in quartos if any(c.status == "AGENDADO" for c in q.camas.values()))
        quartos_bloqueados = sum(1 for q in quartos if _is_room_blocked(q))

        excludes_blocked = bool(self.config.get("kpi_count_free_excludes_blocked", False))
        blocked_numbers = {q.number for q in quartos if _is_room_blocked(q)}
        vagas_livres = 0
        for q in quartos:
            for c in q.camas.values():
                if c.status == "DISPONÍVEL" and (not excludes_blocked or q.number not in blocked_numbers):
                    vagas_livres += 1

        indisponiveis_quartos = 0
        for q in quartos:
            tem_ocupado = any(c.status == "RESERVADO" for c in q.camas.values())
            tem_bloq = _is_room_blocked(q)
            if tem_ocupado or tem_bloq:
                indisponiveis_quartos += 1
        perc_ind = (indisponiveis_quartos / total_quartos * 100.0) if total_quartos else 0.0

        return {
            "total_quartos": total_quartos,
            "total_vagas": total_vagas,
            "vagas_ocupadas": vagas_ocupadas,
            "vagas_livres": vagas_livres,
            "quartos_ocupados": quartos_ocupados,
            "quartos_Agendados": quartos_Agendados,
            "quartos_bloqueados": quartos_bloqueados,
            "indisponiveis_quartos": indisponiveis_quartos,
            "perc_indisponiveis_quartos": round(perc_ind, 1),
        }

    def validar_codigo_reserva(self, q: Quarto, c: Cama, res_idx: int):
        from PySide6.QtWidgets import QInputDialog, QMessageBox
        import datetime as dt

        # Verifica se há reservas
        if not c.reservations:
            return

        # Pega a reserva (normalmente a primeira ou a que foi clicada)
        r = c.reservations[res_idx] if res_idx < len(c.reservations) else c.reservations[0]

        # Se já estiver confirmado, avisa e para
        if r.get("status_confirmacao") == "CONFIRMADO":
            QMessageBox.information(self, "Já confirmado", "Esta reserva já foi validada e confirmada.")
            return

        # Pede o código ao operador
        codigo_digitado, ok = QInputDialog.getText(
            self,
            "Check-in (Validação)",
            f"Reserva de: {r.get('nome', 'Hóspede')}\n\nDigite o código de confirmação recebido por e-mail:"
        )

        if not ok:
            return

        # Compara removendo espaços em branco
        codigo_real = str(r.get("codigo_confirmacao", "")).strip()
        digitado = str(codigo_digitado).strip()

        if digitado != codigo_real:
            QMessageBox.warning(self, "Erro", "❌ Código incorreto! O check-in não foi realizado.")
            return

        # --- SUCESSO ---
        r["status_confirmacao"] = "CONFIRMADO"
        r["codigo_validado_em"] = dt.datetime.now().strftime("%d/%m/%Y %H:%M")

        # Atualiza visualmente para VERMELHO
        c.status = "OCUPADO"
        c.last_action = "CHECK-IN CONFIRMADO"
        c.last_action_at = r["codigo_validado_em"]
        c.last_action_by = self.usuario_ativo

        # Salva no Firebase e atualiza a tela
        self._save_smart(q)
        self.refresh_all()

        QMessageBox.information(self, "Sucesso", "✅ Código validado com sucesso!\nStatus alterado para RESERVADO.")

