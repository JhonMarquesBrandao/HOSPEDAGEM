class Cama:
    def __init__(self, idx, status="DISPONÍVEL", female_only=False, note="", contato=""):
        self.idx = idx
        self.status = status
        self.female_only = bool(female_only)
        self.note = note
        self.contato = contato
        self.reservations = []
        self.reservation = None
        self.interditado_motivo = ""
        self.last_modified_at = None
        self.released_at = None
        self.last_stay_duration_hours = None
        # operadores/ações
        self.last_action_by = None
        self.last_action_at = None
        self.last_action = None
        self.operador_bloqueio = None
        self.operador_liberacao = None

    @property
    def available(self):
        return self.status == "DISPONÍVEL"

    @property
    def reserved(self):
        return self.status == "RESERVADO"

    @property
    def interdited(self):
        return self.status == "INTERDITADO"

    @property
    def cleaning(self):
        return self.status == "LIMPEZA"

    @property
    def scheduled(self):
        return self.status == "AGENDADO"

    def get_active_reservation(self, on_date=None):
        d = on_date or dt.date.today()
        for i, res in enumerate(self.reservations):
            try:
                ci = dt.datetime.strptime(res.get("check_in", ""), "%d/%m/%Y").date()
                co = dt.datetime.strptime(res.get("check_out", ""), "%d/%m/%Y").date()
                if ci <= d <= co:
                    return i, res
            except:
                pass
        return None, None

    def get_next_reservation(self, after_date=None):
        d = after_date or dt.date.today()
        future = []
        for i, res in enumerate(self.reservations):
            try:
                ci = dt.datetime.strptime(res.get("check_in", ""), "%d/%m/%Y").date()
                if ci > d:
                    future.append((ci, i, res))
            except:
                pass
        if not future:
            return None, None
        future.sort(key=lambda tup: tup[0])
        _, i, res = future[0]
        return i, res

    def find_overlap(self, ci_date, co_date, exclude_idx=None):
        for idx, res in enumerate(self.reservations):
            if exclude_idx is not None and idx == exclude_idx:
                continue
            try:
                ex_ci = dt.datetime.strptime(res.get("check_in", ""), "%d/%m/%Y").date()
                ex_co = dt.datetime.strptime(res.get("check_out", ""), "%d/%m/%Y").date()
                if (ci_date <= ex_co) and (ex_ci <= co_date):
                    return idx
            except:
                pass
        return None

    def add_reservation(self, res_dict):
        self.reservations.append(res_dict)

        def _key(r):
            try:
                return dt.datetime.strptime(r.get("check_in", ""), "%d/%m/%Y").date()
            except:
                return dt.date(2100, 1, 1)

        self.reservations.sort(key=_key)

    def remove_reservation(self, idx):
        if idx is None or idx < 0 or idx >= len(self.reservations):
            return None
        try:
            return self.reservations.pop(idx)
        except:
            return None


class Quarto:
    def __init__(self, number, female_only=False):
        self.number = str(number)
        self.camas = {"A": Cama("A", female_only=female_only),
                      "B": Cama("B", female_only=female_only)}


def seed_quartos(fem_set=None):
    if fem_set is None:
        fem_set = {29, 30, 31, 32}
    quartos = {}
    for no in range(1, 33):
        q = Quarto(no, female_only=(no in fem_set))
        quartos[str(no)] = q
    preset = {1: "RESERVADO", 2: "INTERDITADO", 3: "LIMPEZA"}
    for no, st in preset.items():
        if str(no) in quartos:
            quartos[str(no)].camas["A"].status = st
    return quartos


