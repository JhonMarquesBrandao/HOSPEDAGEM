    def status_color_cama(self, c: Cama):
        st = (getattr(c, "status", "") or "").upper()
        if st == "OCUPADO":
            return Theme.DANGER  # Vermelho
        if st == "AGENDADO":
            return Theme.SCHEDULED  # Azul
        if st == "INTERDITADO":
            return Theme.WARNING  # Amarelo
        if st == "DISPONÍVEL":
            return Theme.NEUTRAL  # Verde
        if st == "LIMPEZA":
            # Se quiser manter LIMPEZA esverdeado suave (ou outra cor, fica a seu critério)
            return Theme.SUCCESS
        # fallback
        return Theme.NEUTRAL

    def render_room_cards(self):
        for i in reversed(range(self.grid_layout.count())):
            item = self.grid_layout.itemAt(i)
            w = item.widget()
            if w: w.setParent(None)
        keys = sorted(self.quartos.keys(), key=lambda k: int(k))
        if self.filtered is not None:
            keys = [k for k in keys if k in self.filtered]
        cols = 6
        for idx, key in enumerate(keys):
            row, col = divmod(idx, cols)
            card = self._make_room_card(self.quartos[key])
            self.grid_layout.addWidget(card, row, col)

    def render_area_cards(self):
        """Renderiza os cards compactos das áreas."""
        if hasattr(self, 'areas_grid'):
            # Limpa grid
            for i in reversed(range(self.areas_grid.count())):
                item = self.areas_grid.itemAt(i)
                w = item.widget()
                if w: w.setParent(None)

            keys = sorted(self.areas.keys())
            cols = 4  # 4 colunas para ficar organizado
            for idx, key in enumerate(keys):
                row, col = divmod(idx, cols)
                q_obj = self.areas[key]
                # Chama a função visual nova
                card = self._make_area_card(q_obj)
                self.areas_grid.addWidget(card, row, col)

