            }

        def _cancellations_para_email(self):
            """Coleta cancelamentos do histórico e, se necessário, fallback pela auditoria da cama."""
            rows = []
            for e in (self.historico or []):
                if not isinstance(e, dict): continue
                if (e.get("tipo") or "").upper() == "CANCELAMENTO":
                    rows.append({
                        "quarto": e.get("quarto", ""),
                        "cama": e.get("cama", ""),
                        "nome": e.get("nome", ""),
                        "gerencia": e.get("gerencia", ""),
                        "matricula": e.get("matricula", ""),
                        "periodo": f"{e.get('check_in', '')} → {e.get('check_out', '')}",
                        "quem_cancelou": e.get("operador_cancelamento", "") or e.get("last_action_by", ""),
                        "quando": e.get("cancelado_em", "") or e.get("last_action_at", ""),
                        "motivo": e.get("cancel_reason", "") or "—",
                        "observacao": e.get("obs", "") or "",
                    })
            if not rows:
                for q in self.quartos.values():
                    for c in q.camas.values():
                        if (getattr(c, "last_action", "") or "").upper() == "CANCELAMENTO":
                            rows.append({
                                "quarto": q.number, "cama": c.idx,
                                "nome": "", "gerencia": "", "matricula": "", "periodo": "",
                                "quem_cancelou": getattr(c, "last_action_by", "") or "",
                                "quando": getattr(c, "last_action_at", "") or "",
                                "motivo": (getattr(c, "interditado_motivo", "") or "—"),
                                "observacao": "",
                            })
            return rows

