                    c = int(cnt)
                except:
                    c = 0
                total += c
            agg[ger] = {'pass': agg.get(ger, {}).get('pass', 0) + total}
        top10 = sorted(agg.items(), key=lambda x: x[1]['pass'], reverse=True)[:10]

        # Gênero (ativos hoje)
