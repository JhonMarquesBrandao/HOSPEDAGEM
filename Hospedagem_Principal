    # === LIBERAR CAMA ===
    def liberar_cama(self, q: Quarto, c: Cama):
        today = dt.date.today()
        now_str = dt.datetime.now().strftime("%d/%m/%Y %H:%M")
        active_idx, active_res = c.get_active_reservation(today)
        if active_res is None:
            _, next_res = c.get_next_reservation(today)
            c.status = "AGENDADO" if next_res else "DISPONÍVEL"
            c.last_modified_at = now_str
            c.released_at = now_str
            c.operador_liberacao = self.usuario_ativo or c.operador_liberacao or ""
            try:
                salvar_quartos_firebase(self.quartos)
            except Exception as e:
                print("Warn salvar_quartos_firebase:", e)
            self.refresh_all()
            QMessageBox.information(self, "Liberação",
                                    f"Cama {c.idx} do Quarto {q.number} não estava com reserva ativa.\n"
                                    f"Status ajustado para: {c.status}.")
            return
        try:
            ci_date = dt.datetime.strptime(active_res.get("check_in", ""), "%d/%m/%Y").date()
            co_date = dt.datetime.strptime(active_res.get("check_out", ""), "%d/%m/%Y").date()
        except Exception:
            ci_date = co_date = None

        def _days_reserved(ci, co):
            return ((co - ci).days + 1) if (ci and co and co >= ci) else 0

        def _kits_for(ci, co):
            return (((_days_reserved(ci, co) + 1) // 2)) if _days_reserved(ci, co) > 0 else 0

        days_reserved = _days_reserved(ci_date, co_date)
        kits_qty = _kits_for(ci_date, co_date)
        kits_total_value = round(kits_qty * KIT_PRICE, 2)
        dur_hours = None
        try:
            dur_hours = round((dt.datetime.now() - dt.datetime.combine(ci_date, dt.time())).total_seconds() / 3600, 1)
        except Exception:
            pass
        c.operador_liberacao = self.usuario_ativo or c.operador_liberacao or ""
        hist_entry = {
            "nome": active_res.get("nome", ""),
            "gerencia": active_res.get("gerencia", ""),
            "matricula": active_res.get("matricula", ""),
            "quarto": q.number,
            "cama": c.idx,
            "check_in": active_res.get("check_in", ""),
            "check_out": active_res.get("check_out", ""),
            "released_at": now_str,
            "duracao_horas": dur_hours,
            "days_reserved": days_reserved,
            "kits_qty": kits_qty,
            "kits_total_value": kits_total_value,
            "operador_liberacao": c.operador_liberacao,
        }
        try:
            append_historico(hist_entry);
            self.historico.append(hist_entry)
        except Exception as e:
            print("Warn: não foi possível registrar histórico:", e)
        try:
            incrementa_ranking(active_res.get("nome", ""), active_res.get("gerencia", ""))
            self.ranking = carregar_ranking()
        except Exception as e:
            print("Warn: ranking não atualizado:", e)
        _ = c.remove_reservation(active_idx)
        _, next_res = c.get_next_reservation(today)
        c.status = "AGENDADO" if next_res else "DISPONÍVEL"
        c.note = ""
        c.released_at = now_str
        c.last_modified_at = now_str
        c.last_action_by = self.usuario_ativo or c.last_action_by
        c.last_action_at = now_str
        c.last_action = "LIBERAÇÃO"
        try:
            self._save_smart(q)
        except Exception as e:
            print("Warn salvar_quartos_firebase:", e)
        self.refresh_all()
        msg = (f"✅ Cama {c.idx} do Quarto {q.number} liberada.\n"
               f"• Hóspede: {active_res.get('nome', '—')} ({active_res.get('gerencia', '—')})\n"
               f"• Período: {active_res.get('check_in', '—')} → {active_res.get('check_out', '—')}\n"
               f"• Dias: {days_reserved} \n Kits: {kits_qty} \n Valor kits: R$ {kits_total_value:.2f}\n"
               f"• Novo status: {c.status}")
        QMessageBox.information(self, "Liberação", msg)

    # === Alterar status manual ===
    def set_status_cama(self, q: Quarto, c: Cama, new_status: str):
        now_str = dt.datetime.now().strftime("%d/%m/%Y %H:%M")
        new_status = (new_status or "").strip().upper()
        valid = {"DISPONÍVEL", "RESERVADO", "INTERDITADO", "LIMPEZA", "AGENDADO"}
        if new_status not in valid:
            QMessageBox.warning(self, "Status", f"Status inválido: {new_status}")
            return
        if new_status == "DISPONÍVEL":
            ai, ar = c.get_active_reservation(dt.date.today())
            if ar:
                ret = QMessageBox.question(self, "Liberação necessária",
                                           "Há reserva ativa hoje. Deseja liberar (remover reserva e registrar histórico)?",
                                           QMessageBox.Yes | QMessageBox.No, QMessageBox.Yes)
                if ret == QMessageBox.Yes:
                    self.liberar_cama(q, c)
                    return
        c.interditado_motivo = ""
        c.last_action_by = self.usuario_ativo or ""
        c.last_action_at = now_str
        c.last_action = new_status
        if new_status == "DISPONÍVEL":
            _, nxt = c.get_next_reservation(dt.date.today())
            c.status = "AGENDADO" if nxt else "DISPONÍVEL"
            c.operador_liberacao = c.last_action_by
        elif new_status == "INTERDITADO":
            motivo, ok = QInputDialog.getText(self, "Motivo do bloqueio", "Informe o motivo:")
            if not ok:
                return
            c.interditado_motivo = (motivo or "").strip()
            c.status = "INTERDITADO"
            c.operador_bloqueio = c.last_action_by
        elif new_status == "LIMPEZA":
            c.status = "LIMPEZA"
        elif new_status in {"OCUPADO", "AGENDADO"}:
            c.status = new_status
        c.last_modified_at = now_str
        try:
            self._save_smart(q)
        except Exception as e:
            print("Warn salvar_quartos_firebase:", e)
        self.refresh_all()

    # === Política de bloqueio de quarto (KPIs) ===
    def _is_room_blocked(self, q: Quarto):
        policy = (self.config.get("blocked_room_policy", "any_bed") or "any_bed").strip().lower()
        beds = list(q.camas.values())
        if policy == "both_beds":
            return all(c.interdited for c in beds)
        return any(c.interdited for c in beds)

    # === Sync por data (auto) ===
    def sync_status_by_date(self):
        """
        Sincroniza status pela data, mas respeita a validação do código.
        - Se for hoje + PENDENTE -> Mantém AGENDADO (Azul).
        - Se for hoje + CONFIRMADO -> Muda para RESERVADO (Vermelho).
        """
        today = dt.date.today()
        now_str = dt.datetime.now().strftime("%d/%m/%Y %H:%M")

        for q in self.quartos.values():
            for c in q.camas.values():
                # 1. Se estiver bloqueado manualmente ou em limpeza, não toca
                if c.interdited or c.cleaning:
                    continue

                # 2. Verifica se tem reserva ativa para HOJE (check-in <= hoje <= check-out)
                active_idx, active_res = c.get_active_reservation(today)

                if active_res:
                    # Verifica o status da confirmação (código)
                    # Se não tiver a chave (reserva antiga), assume CONFIRMADO para não travar
                    status_conf = active_res.get("status_confirmacao", "CONFIRMADO")

                    if status_conf == "PENDENTE":
                        # É hoje, mas falta o código: Força AGENDADO (Azul)
                        if c.status != "AGENDADO":
                            c.status = "AGENDADO"
                            c.last_modified_at = now_str
                    else:
                        # É hoje e já validou o código: Força RESERVADO (Vermelho)
                        if c.status != "OCUPADO":
                            c.status = "OCUPADO"
                            c.last_modified_at = now_str
                    continue

                # 3. Se não tem reserva para hoje, verifica o futuro
                _, next_res = c.get_next_reservation(today)
                new_status = "AGENDADO" if next_res else "DISPONÍVEL"

                if c.status != new_status:
                    c.status = new_status
                    c.last_modified_at = now_str

    def auto_refresh(self):
        try:
            print("[auto_refresh] tick")
            self.sync_status_by_date()
            self.refresh_all()
        except Exception as e:
            print("[auto_refresh] erro:", e)

