    def _add_blink_badge(self, layout: QHBoxLayout, text: str, base_color: str, blink: bool, on_click):
        lbl = QLabel(text)
        lbl.setStyleSheet(f"background:{base_color}; color:white; padding:3px 8px; font-size:11px; border-radius:8px;")
        if on_click:
            lbl.mousePressEvent = lambda e: on_click()
        layout.addWidget(lbl)
        if blink:
            timer = QTimer(lbl)

            def _toggle():
                state = lbl.property("blink_state")
                lbl.setProperty("blink_state", not bool(state))
                new_bg = base_color if not bool(state) else "#FCA5A5"
                lbl.setStyleSheet(
                    f"background:{new_bg}; color:white; padding:3px 8px; font-size:11px; border-radius:8px;")

            timer.timeout.connect(_toggle)
            lbl.setProperty("blink_state", False)
            timer.start(700)

