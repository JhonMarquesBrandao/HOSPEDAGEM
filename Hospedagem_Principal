# ==== TLS corporativo ====
def _resolve_verify():
    if os.getenv("ALLOW_INSECURE_SSL") == "1":
        urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)
        print("[TLS] DEV: verify=False")
        return False
    for env_key in ("REQUESTS_CA_BUNDLE", "SSL_CERT_FILE", "CA_BUNDLE"):
        ca_env = os.getenv(env_key)
        if ca_env and os.path.exists(ca_env):
            return ca_env
    return certifi.where()


REQUESTS_VERIFY = _resolve_verify()
print(f"[TLS] verify={REQUESTS_VERIFY}")


