    # === Mapa de Reservas ===

    def status_color_mapa(self, status):
        st = (status or "").upper()
        if st in ("OCUPADO", "RESERVADO"):  # no mapa, "reservado" do dia é uso efetivo/ocupado
            return Theme.DANGER  # Vermelho
        if st == "AGENDADO":
            return Theme.SCHEDULED  # Azul
        if st == "INTERDITADO":
            return Theme.WARNING  # Amarelo
        if st == "DISPONÍVEL":
            return Theme.NEUTRAL  # Verde
        if st == "LIMPEZA":
            return Theme.SUCCESS
        return Theme.NEUTRAL

    def _mapear_reservas_para_dias(self, dias, nomes_limit=2):
        mapa = {}
        for q in self.quartos.values():
            for c in q.camas.values():
                for r in c.reservations:
                    try:
                        ci = dt.datetime.strptime(r["check_in"], "%d/%m/%Y").date()
                        co = dt.datetime.strptime(r["check_out"], "%d/%m/%Y").date()
                    except:
                        continue
                    for dia in dias:
                        if ci <= dia <= co:
                            chave = (q.number, dia)
                            nm = r.get("nome", "")
                            if chave in mapa:
                                nomes = mapa[chave]["nomes"]
                                if nm and nm not in nomes and len(nomes) < nomes_limit:
                                    nomes.append(nm)
                            else:
                                mapa[chave] = {"status": "RESERVADO", "nomes": [nm] if nm else []}
        return mapa

