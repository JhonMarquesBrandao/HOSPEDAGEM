        def start_daily_admin_email_timer(self, hour=21, minute=0):
            """Envia 1x/dia no horário escolhido usando QTimer."""
            from PySide6.QtCore import QTimer
            self._daily_email_timer = QTimer(self)

            def _tick():
                import datetime as _dt
                now = _dt.datetime.now()
                if now.hour == hour and now.minute == minute:
                    mk = now.strftime('%Y-%m-%d %H:%M')
                    if getattr(self, '_last_daily_email_at', None) != mk:
                        self.enviar_relatorio_admins()
                        self._last_daily_email_at = mk

            self._daily_email_timer.timeout.connect(_tick)
            self._daily_email_timer.start(30_000)

