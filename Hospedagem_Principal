    u = (usuario or "").strip().upper()
    if u in usuarios and (usuarios[u].get("senha") == senha):
        return True, usuarios[u].get("privilegio", "usuario"), usuarios[u].get("gerencia", "SOP/ARM")
    return False, None, None


def gerar_senha_temporaria():
    letras = ''.join(secrets.choice(string.ascii_uppercase) for _ in range(2))
    bloco1 = ''.join(secrets.choice(string.digits) for _ in range(2))
    bloco2 = ''.join(secrets.choice(string.digits) for _ in range(4))
    return f"SOP-{letras}{bloco1}-{bloco2}"


def enviar_email_outlook(destinatario, assunto, corpo_html):
    if not OUTLOOK_AVAILABLE:
        print("[Outlook] indisponível. Instale pywin32 e use Windows com Outlook.")
        return False
    try:
        pythoncom.CoInitialize()
        outlook = win32com.client.Dispatch("Outlook.Application")
        mail = outlook.CreateItem(0)
        mail.To = destinatario
        mail.Subject = assunto
        mail.HTMLBody = corpo_html
        mail.Send()
        return True
    except Exception as e:
        print(f"Erro no envio de e-mail: {e}")
        return False
    finally:
        try:
            pythoncom.CoUninitialize()
        except:
            pass


