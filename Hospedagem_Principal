def quartos_to_dict(quartos):
    data = {}
    for qnum, q in quartos.items():
        data[qnum] = {"number": q.number, "camas": {}}
        for cid, c in q.camas.items():
            data[qnum]["camas"][cid] = {
                "idx": c.idx, "status": c.status, "female_only": c.female_only,
                "note": c.note, "contato": c.contato,
                "reservations": c.reservations,
                "reservation": c.reservation,
                "interditado_motivo": c.interditado_motivo,
                "last_modified_at": c.last_modified_at,
                "released_at": c.released_at,
                "last_stay_duration_hours": c.last_stay_duration_hours,
                "last_action_by": c.last_action_by,
                "last_action_at": c.last_action_at,
                "last_action": c.last_action,
                "operador_bloqueio": c.operador_bloqueio,
                "operador_liberacao": c.operador_liberacao,
            }
    return data


def dict_to_quartos(data):
    quartos = {}
    if not data: return quartos

    def _load_cama(c, cd):
        c.status = cd.get("status", "DISPONÍVEL")
        c.female_only = cd.get("female_only", False)
        c.note = cd.get("note", "")
        c.contato = cd.get("contato", "")
        c.reservations = cd.get("reservations", []) or []
        legacy = cd.get("reservation", None)
        if legacy and not c.reservations:
            c.reservations = [legacy]
        c.reservation = legacy if legacy else None
        c.interditado_motivo = cd.get("interditado_motivo", "")
        c.last_modified_at = cd.get("last_modified_at", None)
        c.released_at = cd.get("released_at", None)
        c.last_stay_duration_hours = cd.get("last_stay_duration_hours", None)
        c.last_action_by = cd.get("last_action_by", None)
        c.last_action_at = cd.get("last_action_at", None)
        c.last_action = cd.get("last_action", None)
        c.operador_bloqueio = cd.get("operador_bloqueio", None)
        c.operador_liberacao = cd.get("operador_liberacao", None)

    if isinstance(data, list):
        for qd in data:
            if qd and "number" in qd:
                qnum = str(qd["number"]);
                q = Quarto(qnum)
                for cid, cd in qd.get("camas", {}).items():
                    _load_cama(q.camas[cid], cd)
                quartos[qnum] = q
    else:
        for qnum, qd in data.items():
            q = Quarto(qnum)
            for cid, cd in qd.get("camas", {}).items():
                _load_cama(q.camas[cid], cd)
            quartos[str(qnum)] = q
    return quartos


def firebase_retry(max_retries=3, fallback=None):
    def decorator(func):
        @wraps(func)
        def wrapper(*args, **kwargs):
            for attempt in range(max_retries):
                try:
                    return func(*args, **kwargs)
                except Exception as e:
                    if attempt == max_retries - 1:
                        print(f"Falha após {max_retries} tentativas: {e}")
                        return fallback() if callable(fallback) else fallback
                time.sleep(2 ** attempt)
            return None

        return wrapper

    return decorator


