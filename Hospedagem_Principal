        if len(c.reservations) > 0:
            act_conf = QAction("✅ Confirmar Check-in (Digitar Código)", self)
            # Chama a função de validação na reserva ativa (índice 0 ou busca ativa)
            act_conf.triggered.connect(lambda: self.validar_codigo_reserva(q, c, 0))
            menu.addAction(act_conf)
