    # ==== Cálculos auxiliares para Excel ====
    def _collect_intervals(self):
        daily = {}
        for q in self.quartos.values():
            for c in q.camas.values():
                for r in c.reservations:
                    try:
                        ci = dt.datetime.strptime(r.get("check_in", ""), "%d/%m/%Y").date()
                        co = dt.datetime.strptime(r.get("check_out", ""), "%d/%m/%Y").date()
                    except:
                        continue
                    d = ci
                    while d <= co:
                        daily[d] = daily.get(d, 0) + 1
                        d += dt.timedelta(days=1)
        return daily

    def _build_daily_occupancy(self, daily_dict):
        return daily_dict

    def _all_bed_count(self):
        return sum(len(q.camas) for q in self.quartos.values())

    def _month_key(self, d: dt.date):
        return f"{d.year:04d}-{d.month:02d}"

    def _days_in_month(self, year, month):
        if month == 12:
            next_month = dt.date(year + 1, 1, 1)
        else:
            next_month = dt.date(year, month + 1, 1)
        this_month = dt.date(year, month, 1)
        return (next_month - this_month).days

